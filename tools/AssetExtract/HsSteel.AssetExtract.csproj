<Project Sdk="Microsoft.NET.Sdk">

  <!-- CAD-less DWG -> Drive DB card extractor (ACadSharp, no DXF conversion). Usage: see Program.cs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>HsSteel.AssetExtract</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- ACadSharp 3.8.0 comes transitively from HsSteel.Assets (BlockCatalog / DwgStyleReader use the same reader). -->
    <ProjectReference Include="..\..\src\HsSteel.Assets\HsSteel.Assets.csproj" />
  </ItemGroup>

</Project>
